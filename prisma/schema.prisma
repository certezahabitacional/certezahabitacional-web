generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  DIRECTOR
  ADMINISTRADOR
  VENDEDOR
  GERENTE
  COORDINADOR
  INSPECTOR
  CLIENTE
}

enum EstadoInspeccion {
  PROGRAMADA
  EN_PROCESO
  REPORTE_PENDIENTE
  FINALIZADA
  CANCELADA
}

enum TipoCliente {
  PARTICULAR
  INMOBILIARIA
  CONSTRUCTORA
  INVERSIONISTA
}

enum EstadoCotizacion {
  BORRADOR
  PENDIENTE_AUTORIZACION
  AUTORIZADA
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CANCELADA
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADO
}

enum EsquemaPago {
  UNA_EXHIBICION
  DOS_EXHIBICIONES
  TRES_EXHIBICIONES
}

enum TipoCalculoPrecio {
  FIJO
  POR_M2
  HIBRIDO
}

enum ClasificacionHallazgo {
  CRITICO
  MAYOR
  MENOR
  OBSERVACION
}

enum PrioridadHallazgo {
  ALTA
  MEDIA
  BAJA
}

enum EstadoSeguimientoHallazgo {
  PENDIENTE
  CORREGIDO
  PARCIAL
  NO_CORREGIDO
  NO_APLICA
}

enum EstadoReasignacionInspector {
  PENDIENTE
  AUTORIZADA
  RECHAZADA
  CANCELADA
}

enum TipoDecisionRevision {
  APROBAR
  RECHAZAR
  OBSERVAR
}

enum EstadoDecisionRevision {
  VIGENTE
  REVOCADA
}

enum TipoEvento {
  CREAR
  EDITAR
  ELIMINAR
  LOGIN
  LOGOUT
  AUTORIZAR
  RECHAZAR
  AGENDAR
  REASIGNAR
  INICIAR
  FINALIZAR
  EMITIR_REPORTE
  EMITIR_CERTIFICADO
  REVOCAR_CERTIFICADO
  REACTIVAR_CERTIFICADO
  SUBIR_EVIDENCIA
  ELIMINAR_EVIDENCIA
  FIRMAR
  DESCARGAR_REPORTE
  FINALIZAR_CAPTURA
  REVISION_INSPECCION
  BLOQUEAR_LIBERACION
  DESBLOQUEAR_LIBERACION
}

model PlantillaInspeccion {
  id String @id @default(cuid())
  nombre String
  codigo String @unique
  descripcion String?
  tipoServicio String
  activa Boolean @default(true)
  requiereGerenteZona Boolean @default(false)
  requiereCoordinador Boolean @default(false)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  inspecciones Inspeccion[]
  @@index([activa])
  @@index([tipoServicio])
}

model Zona {
  id String @id @default(cuid())
  nombre String
  codigo String @unique
  ciudad String?
  estado String?
  zonaHoraria String @default("America/Ciudad_Juarez")
  activa Boolean @default(true)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  usuarios Usuario[]
  inspecciones Inspeccion[]
  cotizaciones Cotizacion[]
  @@index([nombre])
  @@index([activa])
}

model Usuario {
  id String @id @default(cuid())
  nombre String
  email String @unique
  telefono String?
  ciudad String?
  passwordHash String
  rol RolUsuario @default(INSPECTOR)
  activo Boolean @default(true)
  requiereCambioPassword Boolean @default(false)
  ultimoAcceso DateTime?
  intentosFallidos Int @default(0)
  bloqueadoHasta DateTime?
  ultimoFalloLogin DateTime?
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  zonaId String?
  zona Zona? @relation(fields: [zonaId], references: [id], onDelete: SetNull)
  gerenteId String?
  gerente Usuario? @relation("GerenteCoordinadores", fields: [gerenteId], references: [id], onDelete: SetNull)
  coordinadoresACargo Usuario[] @relation("GerenteCoordinadores")
  coordinadorId String?
  coordinador Usuario? @relation("CoordinadorInspectores", fields: [coordinadorId], references: [id], onDelete: SetNull)
  inspectoresACargo Usuario[] @relation("CoordinadorInspectores")
  inspector Inspector?
  cliente Cliente?
  hallazgosCreados Hallazgo[] @relation("HallazgoCreadoPor")
  fotosSubidas Fotografia[] @relation("FotoSubidaPor")
  eventos EventoAuditoria[]
  cotizacionesCreadas Cotizacion[] @relation("CotizacionCreadaPor")
  cotizacionesAutorizadas Cotizacion[] @relation("CotizacionAutorizadaPor")
  cotizacionesRechazadas Cotizacion[] @relation("CotizacionRechazadaPor")
  inspeccionesAgendadas Inspeccion[] @relation("InspeccionAgendadaPor")
  pagosRegistrados PagoCotizacion[] @relation("PagoCotizacionRegistradoPor")
  excepcionesApertura Cotizacion[] @relation("CotizacionExcepcionAperturaPor")
  excepcionesInicio Cotizacion[] @relation("CotizacionExcepcionInicioPor")
  observacionesAgenda ObservacionAgenda[] @relation("ObservacionAgendaRegistradaPor")
  revisionesInspeccion RevisionInspeccion[] @relation("RevisionUsuario")
  bloqueosLiberacion Inspeccion[] @relation("InspeccionBloqueadaPor")
  reasignacionesSolicitadas ReasignacionInspector[] @relation("ReasignacionSolicitadaPor")
  reasignacionesResueltas ReasignacionInspector[] @relation("ReasignacionResueltaPor")
  @@index([bloqueadoHasta])
  @@index([zonaId])
  @@index([gerenteId])
  @@index([coordinadorId])
}

model Cliente {
  id String @id @default(cuid())
  folio String @unique @default(dbgenerated("('CH-CLI-'::text || ((EXTRACT(year FROM CURRENT_DATE))::integer)::text) || '-'::text || lpad((nextval('\\\"Cliente_folio_seq\\\"'::regclass))::text, 6, '0'::text))"))
  usuarioId String? @unique
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nombre String
  telefono String?
  correo String?
  tipo TipoCliente @default(PARTICULAR)
  empresa String?
  rfc String?
  curp String?
  direccion String?
  colonia String?
  ciudad String?
  estado String?
  codigoPostal String?
  notas String?
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @default(now()) @updatedAt
  inmuebles Inmueble[]
  inspecciones Inspeccion[]
  cotizaciones Cotizacion[]
  @@index([folio])
  @@index([nombre])
  @@index([correo])
  @@index([telefono])
  @@index([rfc])
}

model Inmueble {
  id String @id @default(cuid())
  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  alias String
  tipo String
  direccion String
  colonia String?
  ciudad String
  estado String
  codigoPostal String?
  superficieTerrenoM2 Decimal? @db.Decimal(10, 2)
  superficieConstruccionM2 Decimal? @db.Decimal(10, 2)
  anioConstruccion Int?
  nombreConstructor String?
  desarrollo String?
  numeroEscritura String?
  latitud Decimal? @db.Decimal(10, 7)
  longitud Decimal? @db.Decimal(10, 7)
  notas String?
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  inspecciones Inspeccion[]
  cotizaciones Cotizacion[]
  @@index([clienteId])
  @@index([ciudad])
}

model Inspector {
  id String @id @default(cuid())
  usuarioId String @unique
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  telefono String?
  especialidad String?
  cedula String?
  ciudad String?
  activo Boolean @default(true)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  inspecciones Inspeccion[]
  pagosComision PagoComision[]
}

model Inspeccion {
  id String @id @default(cuid())
  folio String @unique
  numeroInspeccion Int @default(1)
  inspeccionAnteriorId String?
  inspeccionAnterior Inspeccion? @relation("VersionesInspeccion", fields: [inspeccionAnteriorId], references: [id], onDelete: SetNull)
  inspeccionesSiguientes Inspeccion[] @relation("VersionesInspeccion")
  cotizacionId String? @unique
  cotizacion Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)
  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  inmuebleId String?
  inmueble Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: SetNull)
  inspectorId String?
  inspector Inspector? @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  plantillaId String?
  plantilla PlantillaInspeccion? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  zonaId String?
  zona Zona? @relation(fields: [zonaId], references: [id], onDelete: SetNull)
  agendadaPorId String?
  agendadaPor Usuario? @relation("InspeccionAgendadaPor", fields: [agendadaPorId], references: [id], onDelete: SetNull)
  tipoServicio String
  tipoInmueble String
  direccion String
  ciudad String
  superficieM2 Decimal? @db.Decimal(10, 2)
  fechaProgramada DateTime
  zonaHoraria String @default("America/Ciudad_Juarez")
  estado EstadoInspeccion @default(PROGRAMADA)
  inicioLiberadoSinPago Boolean @default(false)
  inicioLiberadoPorId String?
  inicioLiberadoPor Usuario? @relation("InspeccionLiberadaPor", fields: [inicioLiberadoPorId], references: [id], onDelete: SetNull)
  inicioLiberadoEn DateTime?
  motivoLiberacionPago String?
  bloqueadaLiberacion Boolean @default(false)
  bloqueadaPorId String?
  bloqueadaPor Usuario? @relation("InspeccionBloqueadaPor", fields: [bloqueadaPorId], references: [id], onDelete: SetNull)
  bloqueadaEn DateTime?
  motivoBloqueo String?
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  hallazgos Hallazgo[]
  fotografias Fotografia[]
  firmas Firma[]
  certificado Certificado?
  eventos EventoAuditoria[]
  revisiones RevisionInspeccion[]
  reasignaciones ReasignacionInspector[]
  preparaciones PreparacionTecnica[]
  archivosPlano ArchivoPlano[]
  @@index([clienteId])
  @@index([inmuebleId])
  @@index([inspectorId])
  @@index([plantillaId])
  @@index([zonaId])
  @@index([estado])
  @@index([fechaProgramada])
  @@index([numeroInspeccion])
  @@index([inspeccionAnteriorId])
}

model PreparacionTecnica {
  id String @id @default(cuid())
  inspeccionId String
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  preparadoPorId String
  preparadoPor Usuario @relation(fields: [preparadoPorId], references: [id], onDelete: Restrict)
  descripcion String?
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  detalles PreparacionTecnicaDetalle[]
  @@unique([inspeccionId])
  @@index([preparadoPorId])
}

model PreparacionTecnicaDetalle {
  id String @id @default(cuid())
  preparacionId String
  preparacion PreparacionTecnica @relation(fields: [preparacionId], references: [id], onDelete: Cascade)
  conceptoId String?
  concepto ConceptoInspeccion? @relation(fields: [conceptoId], references: [id], onDelete: SetNull)
  conceptoLibre String?
  incluido Boolean @default(true)
  orden Int @default(0)
  @@index([preparacionId])
  @@index([conceptoId])
}

model ConceptoInspeccion {
  id String @id @default(cuid())
  codigo String @unique
  nombre String
  categoria String
  descripcion String?
  activo Boolean @default(true)
  orden Int @default(0)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  preparaciones PreparacionTecnicaDetalle[]
  @@index([categoria])
  @@index([activo])
  @@index([orden])
}

model ArchivoPlano {
  id String @id @default(cuid())
  inspeccionId String
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  especialidad String
  nombreArchivo String
  url String
  publicId String?
  subidoPorId String
  subidoPor Usuario @relation(fields: [subidoPorId], references: [id], onDelete: Restrict)
  creadoEn DateTime @default(now())
  @@index([inspeccionId])
  @@index([especialidad])
}

model PagoComision {
  id String @id @default(cuid())
  tipoBeneficiario String
  beneficiarioUsuarioId String
  cotizacionId String?
  inspeccionId String?
  porcentaje Decimal @db.Decimal(5, 2)
  baseCalculo Decimal @db.Decimal(12, 2)
  monto Decimal @db.Decimal(12, 2)
  pagado Boolean @default(false)
  pagadoEn DateTime?
  referenciaPago String?
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  @@index([beneficiarioUsuarioId])
  @@index([cotizacionId])
  @@index([inspeccionId])
  @@index([pagado])
}

model ReasignacionInspector {
  id String @id @default(cuid())
  inspeccionId String
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  inspectorAnteriorId String?
  inspectorAnterior Inspector? @relation("ReasignacionInspectorAnterior", fields: [inspectorAnteriorId], references: [id], onDelete: SetNull)
  inspectorPropuestoId String
  inspectorPropuesto Inspector @relation("ReasignacionInspectorPropuesto", fields: [inspectorPropuestoId], references: [id], onDelete: Restrict)
  solicitadaPorId String
  solicitadaPor Usuario @relation("ReasignacionSolicitadaPor", fields: [solicitadaPorId], references: [id], onDelete: Restrict)
  resueltaPorId String?
  resueltaPor Usuario? @relation("ReasignacionResueltaPor", fields: [resueltaPorId], references: [id], onDelete: SetNull)
  estado EstadoReasignacionInspector @default(PENDIENTE)
  motivo String
  comentarioResolucion String?
  solicitadaEn DateTime @default(now())
  resueltaEn DateTime?
  @@index([inspeccionId])
  @@index([inspectorAnteriorId])
  @@index([inspectorPropuestoId])
  @@index([solicitadaPorId])
  @@index([resueltaPorId])
  @@index([estado])
  @@index([solicitadaEn])
}

model RevisionInspeccion {
  id String @id @default(cuid())
  inspeccionId String
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario Usuario @relation("RevisionUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  rol RolUsuario
  decision TipoDecisionRevision
  estado EstadoDecisionRevision @default(VIGENTE)
  comentario String?
  creadaEn DateTime @default(now())
  @@index([inspeccionId])
  @@index([usuarioId])
  @@index([rol])
  @@index([decision])
  @@index([estado])
  @@index([creadaEn])
}

model Hallazgo {
  id String @id @default(cuid())
  inspeccionId String
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  creadoPorId String?
  creadoPor Usuario? @relation("HallazgoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  hallazgoAnteriorId String?
  hallazgoAnterior Hallazgo? @relation("SeguimientoHallazgo", fields: [hallazgoAnteriorId], references: [id], onDelete: SetNull)
  hallazgosSiguientes Hallazgo[] @relation("SeguimientoHallazgo")
  estadoSeguimiento EstadoSeguimientoHallazgo?
  observacionSeguimiento String?
  area String
  titulo String
  descripcion String
  clasificacion ClasificacionHallazgo
  prioridad PrioridadHallazgo
  recomendacion String?
  ubicacion String?
  costoEstimado Decimal? @db.Decimal(12, 2)
  tiempoReparacion String?
  responsable String?
  resuelto Boolean @default(false)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  fotografias Fotografia[]
  @@index([inspeccionId])
  @@index([hallazgoAnteriorId])
  @@index([estadoSeguimiento])
  @@index([clasificacion])
  @@index([prioridad])
}

model Fotografia {
  id String @id @default(cuid())
  inspeccionId String
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  hallazgoId String?
  hallazgo Hallazgo? @relation(fields: [hallazgoId], references: [id], onDelete: SetNull)
  subidaPorId String?
  subidaPor Usuario? @relation("FotoSubidaPor", fields: [subidaPorId], references: [id], onDelete: SetNull)
  url String
  publicId String? @unique
  descripcion String?
  latitud Decimal? @db.Decimal(10, 7)
  longitud Decimal? @db.Decimal(10, 7)
  tomadaEn DateTime?
  creadaEn DateTime @default(now())
  @@index([inspeccionId])
  @@index([hallazgoId])
}

model Firma {
  id String @id @default(cuid())
  inspeccionId String
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  tipo String
  nombreFirmante String
  imagenUrl String
  firmadaEn DateTime @default(now())
  ip String?
  @@index([inspeccionId])
}

model Certificado {
  id String @id @default(cuid())
  inspeccionId String @unique
  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  folio String @unique
  codigoValidacion String @unique
  dictamen String
  ish Decimal @db.Decimal(5, 2)
  emitidoEn DateTime @default(now())
  pdfUrl String?
  vigente Boolean @default(true)
  motivoRevocacion String?
  revocadoEn DateTime?
}

model EventoAuditoria {
  id String @id @default(cuid())
  usuarioId String?
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  inspeccionId String?
  inspeccion Inspeccion? @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  tipo TipoEvento
  entidad String
  entidadId String?
  descripcion String
  ip String?
  navegador String?
  creadoEn DateTime @default(now())
  @@index([usuarioId])
  @@index([inspeccionId])
  @@index([tipo])
  @@index([entidad, entidadId])
  @@index([creadoEn])
}

model PaqueteServicio {
  id String @id @default(cuid())
  nombre String
  codigo String @unique
  descripcion String?
  tipoCalculo TipoCalculoPrecio @default(HIBRIDO)
  precioBase Decimal @db.Decimal(12, 2)
  superficieIncluidaM2 Decimal? @db.Decimal(10, 2)
  precioM2Adicional Decimal? @db.Decimal(12, 2)
  superficieMinimaM2 Decimal? @db.Decimal(10, 2)
  superficieMaximaM2 Decimal? @db.Decimal(10, 2)
  activo Boolean @default(true)
  orden Int @default(0)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  cotizaciones Cotizacion[]
  @@index([activo])
  @@index([orden])
}

model Cotizacion {
  id String @id @default(cuid())
  folio String @unique
  origenPublico Boolean @default(false)
  editablePublica Boolean @default(true)
  versionActual Int @default(1)
  zonaId String?
  zona Zona? @relation(fields: [zonaId], references: [id], onDelete: SetNull)
  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  inmuebleId String?
  inmueble Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: SetNull)
  paqueteId String?
  paquete PaqueteServicio? @relation(fields: [paqueteId], references: [id], onDelete: SetNull)
  creadaPorId String?
  creadaPor Usuario? @relation("CotizacionCreadaPor", fields: [creadaPorId], references: [id], onDelete: SetNull)
  autorizadaPorId String?
  autorizadaPor Usuario? @relation("CotizacionAutorizadaPor", fields: [autorizadaPorId], references: [id], onDelete: SetNull)
  autorizadaEn DateTime?
  rechazadaPorId String?
  rechazadaPor Usuario? @relation("CotizacionRechazadaPor", fields: [rechazadaPorId], references: [id], onDelete: SetNull)
  rechazadaEn DateTime?
  motivoRechazo String?
  solicitudAutorizacionEn DateTime?
  aceptadaEn DateTime?
  zonaHoraria String @default("America/Ciudad_Juarez")
  superficieM2 Decimal? @db.Decimal(10, 2)
  precioBase Decimal @default(0) @db.Decimal(12, 2)
  metrosAdicionales Decimal @default(0) @db.Decimal(10, 2)
  cargoMetrosAdicionales Decimal @default(0) @db.Decimal(12, 2)
  cargosExtra Decimal @default(0) @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @default(0) @db.Decimal(12, 2)
  estado EstadoCotizacion @default(BORRADOR)
  estadoPago EstadoPago @default(PENDIENTE)
  esquemaPago EsquemaPago @default(UNA_EXHIBICION)
  montoPagado Decimal @default(0) @db.Decimal(12, 2)
  excepcionApertura Boolean @default(false)
  excepcionAperturaPorId String?
  excepcionAperturaPor Usuario? @relation("CotizacionExcepcionAperturaPor", fields: [excepcionAperturaPorId], references: [id], onDelete: SetNull)
  excepcionAperturaEn DateTime?
  motivoExcepcionApertura String?
  excepcionInicio Boolean @default(false)
  excepcionInicioPorId String?
  excepcionInicioPor Usuario? @relation("CotizacionExcepcionInicioPor", fields: [excepcionInicioPorId], references: [id], onDelete: SetNull)
  excepcionInicioEn DateTime?
  motivoExcepcionInicio String?
  vigenciaHasta DateTime?
  notas String?
  observacionesInternas String?
  inspeccion Inspeccion?
  versiones CotizacionVersion[]
  pagos PagoCotizacion[]
  observacionesAgenda ObservacionAgenda[]
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  @@index([clienteId])
  @@index([inmuebleId])
  @@index([paqueteId])
  @@index([creadaPorId])
  @@index([zonaId])
  @@index([origenPublico])
  @@index([editablePublica])
  @@index([estado])
  @@index([estadoPago])
  @@index([aceptadaEn])
  @@index([autorizadaEn])
  @@index([excepcionApertura])
  @@index([excepcionInicio])
  @@index([creadoEn])
}

model PagoCotizacion {
  id String @id @default(cuid())
  cotizacionId String
  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  monto Decimal @db.Decimal(12, 2)
  fechaPago DateTime
  referencia String?
  metodoPago String?
  notas String?
  registradoPorId String
  registradoPor Usuario @relation("PagoCotizacionRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  creadoEn DateTime @default(now())
  @@index([cotizacionId])
  @@index([fechaPago])
  @@index([registradoPorId])
}

model ObservacionAgenda {
  id String @id @default(cuid())
  cotizacionId String
  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  observacion String
  registradaPorId String
  registradaPor Usuario @relation("ObservacionAgendaRegistradaPor", fields: [registradaPorId], references: [id], onDelete: Restrict)
  creadaEn DateTime @default(now())
  actualizadaEn DateTime @updatedAt
  @@index([cotizacionId])
  @@index([registradaPorId])
  @@index([creadaEn])
}

model CotizacionVersion {
  id String @id @default(cuid())
  cotizacionId String
