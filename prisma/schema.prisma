generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMINISTRADOR
  SUPERVISOR
  INSPECTOR
  CLIENTE
}

enum EstadoInspeccion {
  PROGRAMADA
  EN_PROCESO
  REPORTE_PENDIENTE
  FINALIZADA
  CANCELADA
}

enum TipoCliente {
  PARTICULAR
  INMOBILIARIA
  CONSTRUCTORA
  INVERSIONISTA
}

enum ClasificacionHallazgo {
  C
  O
  NC
  CR
  NA
}

enum PrioridadHallazgo {
  P1
  P2
  P3
  P4
  P5
}

model Usuario {
  id               String            @id @default(cuid())
  nombre           String
  email            String            @unique
  passwordHash     String
  rol              RolUsuario        @default(INSPECTOR)
  activo           Boolean           @default(true)
  ultimoAcceso     DateTime?
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt
  inspector        Inspector?
  cliente          Cliente?
  hallazgosCreados Hallazgo[]        @relation("HallazgoCreadoPor")
  fotosSubidas     Fotografia[]      @relation("FotoSubidaPor")
  eventos          EventoAuditoria[]
}

model Cliente {
  id            String       @id @default(cuid())
  usuarioId     String?      @unique
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nombre        String
  telefono      String?
  correo        String?
  tipo          TipoCliente  @default(PARTICULAR)
  empresa       String?
  rfc           String?
  curp          String?
  direccion     String?
  colonia       String?
  ciudad        String?
  estado        String?
  codigoPostal  String?
  notas         String?
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @default(now()) @updatedAt
  inmuebles     Inmueble[]
  inspecciones  Inspeccion[]

  @@index([nombre])
  @@index([correo])
  @@index([telefono])
  @@index([rfc])
}

model Inmueble {
  id                       String       @id @default(cuid())
  clienteId                String
  cliente                  Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  alias                    String
  tipo                     String
  direccion                String
  colonia                  String?
  ciudad                   String
  estado                   String
  codigoPostal             String?
  latitud                  Decimal?     @db.Decimal(10, 7)
  longitud                 Decimal?     @db.Decimal(10, 7)
  superficieTerrenoM2      Decimal?     @db.Decimal(10, 2)
  superficieConstruccionM2 Decimal?     @db.Decimal(10, 2)
  anioConstruccion         Int?
  nombreConstructor        String?      @map("constructor")
  desarrollo               String?
  numeroEscritura          String?
  notas                    String?
  creadoEn                 DateTime     @default(now())
  actualizadoEn            DateTime     @updatedAt
  inspecciones             Inspeccion[]

  @@index([clienteId])
  @@index([ciudad])
}

model Inspector {
  id            String       @id @default(cuid())
  usuarioId     String       @unique
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  telefono      String?
  especialidad  String?
  cedula        String?
  ciudad        String?
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  inspecciones  Inspeccion[]
}

model Inspeccion {
  id              String            @id @default(cuid())
  folio           String            @unique
  clienteId       String
  cliente         Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  inmuebleId      String?
  inmueble        Inmueble?         @relation(fields: [inmuebleId], references: [id], onDelete: SetNull)
  inspectorId     String?
  inspector       Inspector?        @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  tipoServicio    String
  tipoInmueble    String
  direccion       String
  ciudad          String
  superficieM2    Decimal?          @db.Decimal(10, 2)
  fechaProgramada DateTime
  estado          EstadoInspeccion  @default(PROGRAMADA)
  observaciones   String?
  ish             Decimal?          @db.Decimal(5, 2)
  semaforo        String?
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt
  hallazgos       Hallazgo[]
  fotografias     Fotografia[]
  firmas          Firma[]
  certificado     Certificado?
  eventos         EventoAuditoria[]

  @@index([fechaProgramada])
  @@index([estado])
  @@index([clienteId])
  @@index([inmuebleId])
  @@index([inspectorId])
}

model Hallazgo {
  id               String                @id @default(cuid())
  inspeccionId     String
  inspeccion       Inspeccion            @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  creadoPorId      String?
  creadoPor        Usuario?              @relation("HallazgoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  area             String
  titulo           String
  descripcion      String
  clasificacion    ClasificacionHallazgo
  prioridad        PrioridadHallazgo
  recomendacion    String?
  ubicacion        String?
  costoEstimado    Decimal?              @db.Decimal(12, 2)
  tiempoReparacion String?
  responsable      String?
  resuelto         Boolean               @default(false)
  creadoEn         DateTime              @default(now())
  actualizadoEn    DateTime              @updatedAt
  fotografias      Fotografia[]

  @@index([inspeccionId])
  @@index([clasificacion])
  @@index([prioridad])
}

model Fotografia {
  id           String     @id @default(cuid())
  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  hallazgoId   String?
  hallazgo     Hallazgo?  @relation(fields: [hallazgoId], references: [id], onDelete: SetNull)
  subidaPorId  String?
  subidaPor    Usuario?   @relation("FotoSubidaPor", fields: [subidaPorId], references: [id], onDelete: SetNull)
  url          String
  publicId     String?    @unique
  descripcion  String?
  latitud      Decimal?   @db.Decimal(10, 7)
  longitud     Decimal?   @db.Decimal(10, 7)
  tomadaEn     DateTime?
  creadaEn     DateTime   @default(now())

  @@index([inspeccionId])
  @@index([hallazgoId])
}

model Firma {
  id             String     @id @default(cuid())
  inspeccionId   String
  inspeccion     Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  tipo           String
  nombreFirmante String
  imagenUrl      String
  firmadaEn      DateTime   @default(now())
  ip             String?

  @@index([inspeccionId])
}

model Certificado {
  id               String     @id @default(cuid())
  inspeccionId     String     @unique
  inspeccion       Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  folio            String     @unique
  codigoValidacion String     @unique
  dictamen         String
  ish              Decimal    @db.Decimal(5, 2)
  emitidoEn        DateTime   @default(now())
  pdfUrl           String?
  vigente          Boolean    @default(true)
  motivoRevocacion String?
  revocadoEn       DateTime?
}

enum TipoEvento {
  LOGIN
  LOGOUT
  CREAR
  EDITAR
  ELIMINAR
  EMITIR_CERTIFICADO
  REVOCAR_CERTIFICADO
  REACTIVAR_CERTIFICADO
  SUBIR_EVIDENCIA
  ELIMINAR_EVIDENCIA
  FIRMAR
  DESCARGAR_REPORTE
}

model EventoAuditoria {
  id           String      @id @default(cuid())
  usuarioId    String?
  usuario      Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  inspeccionId String?
  inspeccion   Inspeccion? @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  tipo         TipoEvento
  entidad      String
  entidadId    String?
  descripcion  String
  ip           String?
  navegador    String?
  creadoEn     DateTime    @default(now())

  @@index([usuarioId])
  @@index([inspeccionId])
  @@index([tipo])
  @@index([entidad, entidadId])
  @@index([creadoEn])
}
